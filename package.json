{
  "name": "scfrms",
  "private": true,
  "workspaces": [
    "frontend/liff-app",
    "frontend/admin-dashboard",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:liff": "npm run dev --workspace @scfrms/liff-app",
    "dev:admin": "npm run dev --workspace @scfrms/admin-dashboard",
    "dev:backend": "npm run dev --workspace @scfrms/backend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke:intake": "node tests/smoke/intake.mjs",
    "test:smoke:staff-auth": "node tests/smoke/staff-auth.mjs",
    "test:smoke:staff-ticket-read": "node tests/smoke/staff-ticket-read.mjs",
    "build": "npm run build --workspaces",
    "infra:typecheck": "tsc -p infrastructure/aws/tsconfig.json --noEmit",
    "infra:synth": "cd infrastructure/aws && cdk synth",
    "infra:diff": "cd infrastructure/aws && cdk diff",
    "infra:deploy": "cd infrastructure/aws && cdk deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
