# Local backend only. Do not put secrets in this file.
BACKEND_PORT=3000
# One table per entity (SCFRMS-28); the real names come from the infrastructure.
TICKETS_TABLE_NAME=Tickets
TICKET_REPORTERS_TABLE_NAME=TicketReporters
TICKET_PHOTOS_TABLE_NAME=TicketPhotos
TICKET_EVENTS_TABLE_NAME=TicketEvents
NOTIFICATIONS_TABLE_NAME=Notifications
RATE_LIMITS_TABLE_NAME=RateLimits
# Teams table (work order email per team). Leave empty until it exists; TEAM_EMAILS is the fallback.
TEAMS_TABLE_NAME=
# Staff accounts for the staff login (SR-07).
ACCOUNTS_TABLE_NAME=Accounts
# Per-reporter limit on POST /tickets (default 10 per hour).
TICKET_RATE_LIMIT_PER_HOUR=
AWS_REGION=ap-southeast-1
# Leave empty in real AWS; set to e.g. http://localhost:8000 for DynamoDB Local.
DYNAMODB_ENDPOINT=
LINE_LOGIN_CHANNEL_ID=
UPLOAD_BUCKET_NAME=
BEDROCK_MODEL_ID=
TEAM_EMAILS=
SES_SENDER_EMAIL=
ADMIN_DASHBOARD_URL=
LINE_CHANNEL_ACCESS_TOKEN=
# Signs and verifies staff login tokens (SR-08); at least 32 characters. In AWS it comes from Secrets Manager (SR-34).
STAFF_JWT_SECRET=
# Shown on the LINE receipt (SLA-02); leave empty until the juristic office gives the number.
BUILDING_SECURITY_PHONE=
# LIFF link that the LINE message buttons open, for example https://liff.line.me/<liffId>
LIFF_URL=
# How long the repair photo link in the LINE completion message works, in seconds (60 to 900; default 900, the 15 minute limit of SR-23).
PROOF_PHOTO_URL_TTL_SECONDS=
