# This is shown in the browser. Never put secrets in VITE_ variables.
VITE_APP_TITLE=Staff portal
# Production only: full API URL including /v1. Leave empty in dev (the Vite proxy at /api is used).
VITE_API_BASE_URL=
# Dev only, not sent to the browser: where the /api proxy points (no /v1).
API_PROXY_TARGET=