# This is shown in the browser. Never put secrets in VITE_ variables.
VITE_APP_TITLE=Facility reporter
# LINE Developers Console → LINE Login channel → LIFF tab (looks like 1234567890-AbCdEfGh)
VITE_LIFF_ID=
# Backend API base URL including /v1. Leave empty to use the deployed dev API.
VITE_API_BASE_URL=
