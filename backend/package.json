{
  "name": "@scfrms/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/local.ts",
    "seed:accounts": "node --env-file-if-exists=../.env --import tsx src/scripts/seed-accounts.ts",
    "seed:technician": "node --env-file-if-exists=../.env --import tsx src/scripts/seed-technician.ts",
    "rotate:staff-password": "node --env-file-if-exists=../.env --import tsx src/scripts/rotate-disabled-staff-password.ts",
    "reset:manager-mfa": "node --env-file-if-exists=../.env --import tsx src/scripts/reset-manager-mfa.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1159.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-rekognition": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "bcryptjs": "^3.0.3",
    "sharp": "^0.35.5"
  }
}
