{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "G02 private S3 bucket for CDK Lambda code assets in ap-southeast-1",
  "Resources": {
    "CodeAssets": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "des424-g02-scfrms-cdk-assets-528301714999-ap-southeast-1",
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": "SCFRMS" },
          { "Key": "CourseGroup", "Value": "DES424-G02" },
          { "Key": "Environment", "Value": "dev" }
        ]
      }
    },
    "CodeAssetsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "CodeAssets" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["CodeAssets", "Arn"] },
                { "Fn::Sub": "${CodeAssets.Arn}/*" }
              ],
              "Condition": {
                "Bool": { "aws:SecureTransport": "false" }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "AssetBucketName": { "Value": { "Ref": "CodeAssets" } }
  }
}
